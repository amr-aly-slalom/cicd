#!/usr/bin/env bash
# Installed via `make setup` (git config core.hooksPath .githooks).
# Runs every gate CI runs except tf-checkov (needs Docker) - see `make
# precommit` in the Makefile. `make tf-checkov`/`make check` still cover it,
# by hand or in CI.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
make precommit
